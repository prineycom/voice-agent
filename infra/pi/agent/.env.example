# LiveKit SFU (worker runs on the Pi, connects over localhost)
LIVEKIT_URL=ws://localhost:7880
# Reuse the canonical pair from infra/pi/.env (the same key/secret the SFU loads).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Desktop STT service (over Tailscale)
STT_WS_URL=ws://100.75.88.35:8001/stt
STT_HEALTH_URL=http://100.75.88.35:8001/health
STT_SAMPLE_RATE=16000      # sample rate the plugin sends audio at; MUST match the Desktop STT server's expected input rate (16kHz). Mismatch = garbled transcripts
STT_LANGUAGE=ru            # BCP-47 tag attached to returned SpeechData.language metadata only — NOT sent to the server. To change the actual recognition language, set STT_LANGUAGE on the Desktop STT server (infra/desktop/stt/.env)

# Desktop TTS service (over Tailscale)
TTS_WS_URL=ws://100.75.88.35:8002/tts
TTS_HEALTH_URL=http://100.75.88.35:8002/health
TTS_VOICE=default          # static fallback Voice when nothing is persisted (-> server default speaker). The live active Voice is the persisted global below (voice switcher, #48).
TTS_SAMPLE_RATE=24000      # rate the plugin labels published frames with; MUST match the server's output rate (24kHz). Mismatch = pitch/speed artifacts

# Voice switcher (ADR-0020 / #48): the persisted active Voice (CustomVoice preset
# speaker), a server-side global switched via the web front door's /voices,/voice
# endpoints and read live by the worker. The web server + worker MUST share this
# path (both default to the same location, so leave unset unless relocating it).
# VOICE_STATE_PATH=~/.local/state/voice-agent/active-voice
# VOICE_DEFAULT=ryan       # fallback preset when nothing is persisted yet

# Wake-word activation (ADR-0021 / Epic #56). The agent starts Dormant and silent;
# a wake word ("Приней"/"Приня"/"хей джарвис") wakes it. Detection runs server-side
# on the Pi (livekit-wakeword ONNX gate) in front of the Desktop GPU STT.
WAKEWORD_ENABLED=1                 # master flag. 0 = today's always-listening behavior (no gate, greeting kept)
# Comma-separated classifier ONNX path(s) — one combined multi-keyword model or
# several single-keyword ones. Defaults to the committed pretrained hey_jarvis.onnx
# (the working out-of-box «хей джарвис»); add models/prinei.onnx once trained (#57).
# WAKEWORD_MODEL_PATHS=<repo>/infra/desktop/wakeword/models/hey_jarvis.onnx
# WAKEWORD_THRESHOLDS_PATH=<repo>/infra/desktop/wakeword/models/thresholds.json
WAKEWORD_THRESHOLD=0.5             # fallback activation cutoff for models absent from thresholds.json
WAKEWORD_STRIDE_S=0.5             # seconds of new audio between classifier scorings (Pi CPU lever)
# Active window (#59). While Active the agent keeps listening without a wake word;
# it auto-sleeps to Dormant after WAKEWORD_SILENCE_TIMEOUT seconds of quiet (reset
# on every user OR agent turn). Say a wake word + «стоп» («Приней, стоп») to sleep
# immediately (a bare «стоп» does not). FOLLOWUP=0 → strict: every user turn needs
# a wake word (e.g. «Приней, погода?» is answered, then it sleeps immediately; a
# barge-in over the reply then also needs a wake word).
WAKEWORD_SILENCE_TIMEOUT=8        # seconds of silence (user OR agent) before Active → Dormant
WAKEWORD_FOLLOWUP=1               # 1 = conversational window (default); 0 = strict per-turn wake word
WAKEWORD_DEBUG=0                  # 1 = log the classifier's per-window scores (>0.02) to tune the threshold on live audio

# Agent
AGENT_GREETING=Привет! Я голосовой ассистент. Чем могу помочь?
# Note: with WAKEWORD_ENABLED=1 the greeting is NOT spoken — the agent is Dormant
# and silent until first woken (ADR-0021). AGENT_GREETING applies only when wake is off.
# Worker's own HTTP server port. The framework prod default (8081) is taken on the
# Pi; 8090 is free. Change only if it collides with another local service.
AGENT_WORKER_PORT=8090

# LLM (via local LiteLLM proxy)
LLM_BASE_URL=http://localhost:4000/v1
LLM_MODEL=qwen3.5-4b         # LiteLLM alias → local Qwen3.5-4B-MTP on the Desktop GPU over Tailscale (ADR 0014). Must match a model entry in the LiteLLM config
LLM_API_KEY=litellm-local    # must equal the LiteLLM master key when one is set
LLM_REASONING_EFFORT=none    # none keeps voice replies snappy; "" to omit, or low/minimal
SOUL_PATH=                   # absolute path to SOUL.md; defaults to <agent dir>/SOUL.md when unset
# Worker skill (Hermes CLI patterns): appended verbatim to the Agent instructions
# alongside SOUL.md. Optional — a missing file is warned, not fatal. Defaults to
# <agent dir>/skills/hermes.md. The whitelist of allowed CLI commands lives in
# config.yaml (worker_tools.allowed_commands), NOT here.
WORKER_SKILL_PATH=
# OLLAMA_API_KEY does NOT go here — it lives in the litellm.service EnvironmentFile (out of repo).

# LiveKit SFU (worker runs on the Pi, connects over localhost)
LIVEKIT_URL=ws://localhost:7880
# Reuse the canonical pair from infra/pi/.env (the same key/secret the SFU loads).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Desktop STT service (over Tailscale)
STT_WS_URL=ws://100.75.88.35:8001/stt
STT_HEALTH_URL=http://100.75.88.35:8001/health
STT_SAMPLE_RATE=16000      # sample rate the plugin sends audio at; MUST match the Desktop STT server's expected input rate (16kHz). Mismatch = garbled transcripts
STT_LANGUAGE=ru            # BCP-47 tag attached to returned SpeechData.language metadata only — NOT sent to the server. To change the actual recognition language, set STT_LANGUAGE on the Desktop STT server (infra/desktop/stt/.env)

# Desktop TTS service (over Tailscale)
TTS_WS_URL=ws://100.75.88.35:8002/tts
TTS_HEALTH_URL=http://100.75.88.35:8002/health
TTS_VOICE=default          # -> server speaker "aiden" (Russian)
TTS_SAMPLE_RATE=24000      # rate the plugin labels published frames with; MUST match the server's output rate (24kHz). Mismatch = pitch/speed artifacts

# Agent
AGENT_GREETING=Привет! Я голосовой ассистент. Чем могу помочь?
# Worker's own HTTP server port. The framework prod default (8081) is taken on the
# Pi; 8090 is free. Change only if it collides with another local service.
AGENT_WORKER_PORT=8090

# LLM (via local LiteLLM proxy)
LLM_BASE_URL=http://localhost:4000/v1
LLM_MODEL=voice-agent        # LiteLLM alias; maps to the local Qwen3.5-4B-MTP on the Desktop GPU (ADR 0014). Must match a model entry in the LiteLLM config
LLM_API_KEY=litellm-local    # must equal the LiteLLM master key when one is set
LLM_REASONING_EFFORT=none    # none keeps voice replies snappy; "" to omit, or low/minimal
SOUL_PATH=                   # absolute path to SOUL.md; defaults to <agent dir>/SOUL.md when unset
# Worker skill (Hermes CLI patterns): appended verbatim to the Agent instructions
# alongside SOUL.md. Optional — a missing file is warned, not fatal. Defaults to
# <agent dir>/skills/hermes.md. The whitelist of allowed CLI commands lives in
# config.yaml (worker_tools.allowed_commands), NOT here.
WORKER_SKILL_PATH=
# OLLAMA_API_KEY does NOT go here — it lives in the litellm.service EnvironmentFile (out of repo).

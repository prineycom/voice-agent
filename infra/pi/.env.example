# LiveKit SFU credentials — copy to .env and fill in.
#   cp .env.example .env
# Generate a pair:
#   LIVEKIT_API_KEY="API$(openssl rand -hex 6)"
#   LIVEKIT_API_SECRET="$(openssl rand -base64 36)"
#
# .env is gitignored. These same values are reused by the Agent Worker (Epic 4)
# and the frontend token server (Epic 5) to sign access tokens.

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

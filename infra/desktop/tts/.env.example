# Desktop TTS service config — Qwen3-TTS (multi-engine).
#
# Pick the engine by TTS_ENGINE; each engine loads its own model and interprets
# the `voice` field in the worker→TTS request {"text","voice"} differently.
# Switching model/voice mode = change TTS_ENGINE (+ engine-specific vars) and
# restart the service. No code change required.

TTS_HOST=0.0.0.0
TTS_PORT=8002
TTS_LANGUAGE=Russian       # ADR-0020 prod: force Russian on custom_voice (English instruct + Auto pulls RU output toward an English accent). Auto = detect per utterance; or English.
TTS_CHUNK_SIZE=4           # custom_voice chunks faster; voice_clone/design prefer 8

# --------------------------------------------------------------------------- #
# Engine selection: custom_voice | voice_clone | voice_design | voxcpm
# PROD is custom_voice (ADR-0020). One-line ROLLBACK to the pasha clone:
#   TTS_ENGINE=voice_clone   (+ its TTS_MODEL/TTS_REF_* below) and restart.
# --------------------------------------------------------------------------- #
TTS_ENGINE=custom_voice

# --------------------------------------------------------------------------- #
# Engine: custom_voice — predefined speaker IDs. Model: CustomVoice.
#   voice in request = speaker name; "default" falls back to TTS_SPEAKER.
#   Switchable presets (UI voice switcher, #48): ryan, aiden, serena, vivian,
#   ono_anna, sohee, uncle_fu. The CN-dialect eric/dylan are excluded for Russian.
#   Emotion is applied per sentence as an `instruct` clause (ADR-0020 / #51),
#   NOT via this file.
# --------------------------------------------------------------------------- #
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_SPEAKER=ryan
# Sampling (ADR-0020): steady delivery, NO fixed seed. Runaway guard = max tokens.
TTS_TEMPERATURE=0.8
TTS_TOP_P=0.9
TTS_TOP_K=50
TTS_REPETITION_PENALTY=1.05
TTS_MAX_NEW_TOKENS=2048

# --------------------------------------------------------------------------- #
# Engine: voice_clone — clone a voice from a reference WAV + its verbatim
# transcript. Model: Base.
#   Simple (one voice): TTS_REF_AUDIO + TTS_REF_TEXT, profile named "default".
#   Multi-voice: TTS_VOICE_REFS=pasha,mama + TTS_REF_pasha_AUDIO / TTS_REF_pasha_TEXT.
#   voice in request = profile name; "default" uses the first configured profile.
#
# TTS_ENGINE=voice_clone
# TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
# TTS_REF_AUDIO=/path/to/ref.wav
# TTS_REF_TEXT=дословная расшифровка того, что говорится в ref.wav
# # Multi-voice alternative:
# # TTS_VOICE_REFS=pasha,mama
# # TTS_REF_pasha_AUDIO=/path/pasha.wav
# # TTS_REF_pasha_TEXT=...
# # TTS_REF_mama_AUDIO=/path/mama.wav
# # TTS_REF_mama_TEXT=...
# --------------------------------------------------------------------------- #

# --------------------------------------------------------------------------- #
# Engine: voice_design — describe a voice by instruction. Model: VoiceDesign.
#   voice in request = instruction string; "default" falls back to TTS_INSTRUCT.
#
# TTS_ENGINE=voice_design
# TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
# TTS_INSTRUCT=Warm, confident male baritone, calm pace, slight Russian intonation
# --------------------------------------------------------------------------- #

# --------------------------------------------------------------------------- #
# A2F fork: tee each TTS utterance's PCM + emotion into the co-located A2F service
# so it produces blendshapes bound to the exact audio. Frames are discarded in Phase 1.
# --------------------------------------------------------------------------- #
A2F_WS_URL=ws://127.0.0.1:8003/a2f
A2F_FORK_ENABLED=1
# Desktop local LLM service — llama.cpp (llama-server) config reference.
#
# The launch flags live in start_llm.ps1 (llama-server takes CLI args, not a
# .env). This file documents the knobs and their tuned values so the service is
# reproducible. Change start_llm.ps1 to apply.

# Binary + model
LLM_SERVER=E:\AI\llama.cpp\bin\llama-server.exe
LLM_MODEL_PATH=E:\AI\models\qwen3.5\Qwen3.5-4B-Q4_K_M.gguf   # unsloth/Qwen3.5-4B-MTP-GGUF (MTP heads built in)

# Network — OpenAI-compatible /v1. LiteLLM route (Tailscale): http://100.75.88.35:8004/v1
LLM_HOST=0.0.0.0     # bind all interfaces so both LAN and Tailscale reach it
LLM_PORT=8004        # 8001=STT, 8002=TTS, 8003=A2F(reserved), 8004=LLM

# GPU / memory — measured LLM footprint ~3.5 GB, leaving ~0.9 GB free with
# STT+TTS resident (~0.5 GB free with A2F helper too). See README.md.
LLM_NGL=99           # offload all layers to GPU
LLM_CTX=16384        # context window; KV is q8_0 GQA so it is cheap (~0.27 GB @16k)
LLM_CACHE_TYPE=q8_0  # KV cache quant (k+v); halves KV memory vs fp16, negligible quality loss
LLM_FLASH_ATTN=on
LLM_BATCH=256        # logical batch
LLM_UBATCH=128       # micro-batch — the real VRAM lever: each compute buffer scales
                     # with it (~123 MiB @128), and there are two (main + MTP draft)

# MTP self-speculative decoding — ~1.4-2.2x generation speedup, no accuracy change.
# Measured: 94% draft acceptance, ~90 tok/s (RU) / ~178 tok/s (EN).
LLM_SPEC_TYPE=draft-mtp
LLM_SPEC_DRAFT_N_MAX=6
LLM_PARALLEL=1       # MTP does not support -np > 1

# Voice latency — non-thinking mode (no <think> reasoning tokens).
# Qwen3.5 honors the jinja enable_thinking kwarg, NOT --reasoning-budget.
# Set it server-wide via the env var (PowerShell mangles the CLI flag's JSON):
LLAMA_CHAT_TEMPLATE_KWARGS={"enable_thinking":false}

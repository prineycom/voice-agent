# Desktop A2F service config — Audio2Face-3D → ARKit blendshapes (Epic 8).

A2F_HOST=0.0.0.0
A2F_PORT=8003
A2F_FPS=30              # output blendshape frame rate
A2F_INPUT_RATE=24000   # incoming TTS PCM16 sample rate (mono)

# Backend: mock | helper
#   mock   — synthetic well-formed blendshapes, no GPU (default; CI + frontend dev)
#   helper — the compiled C++ a2f_stream helper on the batch-1 TensorRT engine
A2F_BACKEND=mock

# helper backend paths (built by build_helper.sh / build_engine.sh)
# A2F_BACKEND=helper
# A2F_HELPER=/opt/a2f/a2f_stream
# A2F_ENGINE=/opt/a2f/network.trt
